# x402 Facilitator Server Configuration

# EVM Private Key (required for EVM networks)
# Supports: Ethereum, Base, Arbitrum, Optimism, Polygon, BSC, Avalanche, IoTeX, Sei, zkSync, Linea, Celo, Gnosis, Fantom
EVM_PRIVATE_KEY=0xYourEVMPrivateKeyHere

# Solana Private Key (required for Solana networks)
# Supports: Solana Mainnet, Solana Devnet
SVM_PRIVATE_KEY=YourSolanaPrivateKeyHere

# Server Configuration
PORT=3000
NODE_ENV=development
