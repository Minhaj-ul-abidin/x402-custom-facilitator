{
  "name": "x402-facilitator-server",
  "version": "1.0.0",
  "description": "Production-ready facilitator server for the x402 payment protocol",
  "main": "index.ts",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx index.ts",
    "dev:watch": "nodemon --exec tsx index.ts --watch . --ext ts,js,json --ignore dist/ --ignore node_modules/",
    "dev:build": "concurrently \"npm run build:watch\" \"npm run dev\"",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write ."
  },
  "keywords": [
    "x402",
    "facilitator",
    "payments",
    "blockchain",
    "multi-chain",
    "EVM",
    "Solana"
  ],
  "author": "x402 Community",
  "license": "Apache-2.0",
  "dependencies": {
    "@solana-program/compute-budget": "^0.9.0",
    "@solana-program/token": "^0.6.0",
    "@solana-program/token-2022": "^0.5.0",
    "@solana/kit": "^3.0.3",
    "@solana/transaction-confirmation": "^3.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "viem": "^2.21.26",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.1.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/coinbase/x402.git"
  },
  "bugs": {
    "url": "https://github.com/coinbase/x402/issues"
  },
  "homepage": "https://github.com/coinbase/x402#readme"
}
